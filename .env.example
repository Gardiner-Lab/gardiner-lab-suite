# Copy to .env and fill in. Never commit the real .env.

# Required. Use two different random values:
#   openssl rand -hex 32
SECRET_KEY=
MOCLO_SECRET_KEY=

# Host port for the whole suite
SUITE_PORT=8080

# Creates the Plasmid Editor's first admin account on an empty database
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set false once the lab has its accounts
ALLOW_REGISTRATION=true

# Pre-filled lab name on parts contributed to the MoClo library
DEFAULT_LAB_SOURCE=Gardiner Lab

# Set true once TLS terminates in front of this stack
SESSION_COOKIE_SECURE=false

# Only for docker-compose.local.yml: where the editor checkout lives
EDITOR_SRC=../plasmid-editor
