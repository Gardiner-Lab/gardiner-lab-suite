# Copy to .env and fill in. Never commit the real .env.

# Required. Use two different random values:
#   openssl rand -hex 32
SECRET_KEY=
MOCLO_SECRET_KEY=

# Host port for the whole suite, served over https (plain http to it is sent
# on to https). See docs/HTTPS.md.
SUITE_PORT=8080

# More names or addresses for the https certificate, comma-separated: the
# machine's IP address, or the name the university's DNS gives it. localhost
# and the machine's own name are always in it. Then: ./scripts/make-certs.sh
SUITE_HOSTNAMES=

# The first administrator. Left empty, the password is admin123, and signing in
# with it asks for a new one before anything else opens.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set false once the lab has its accounts
ALLOW_REGISTRATION=true

# Every lab has its own registration code, which new members need to join it.
# The suite generates them: the first for the DEFAULT_LAB_SOURCE lab when it is
# installed, and the rest on the Labs tab of the dashboard (/account/).
# Set false to let anyone register without a code.
REQUIRE_REGISTRATION_CODE=true

# The first lab, created with its own registration code on a new installation
DEFAULT_LAB_SOURCE=Gardiner Lab

# Sign-in cookies only over https. The suite is served over https, so true.
SESSION_COOKIE_SECURE=true

# Only for docker-compose.local.yml: where the tool checkouts live
MOCLO_SRC=../moclo-library-tool
EDITOR_SRC=../plasmid-editor

# --- Backups (see docs/BACKUP.md) -------------------------------------------
# Where the nightly backup is written. Point this at the mounted network drive
# and run 'make backup-init' once; the backup refuses to run until you do, so
# that a drive which failed to mount is never silently used instead.
BACKUP_DEST=/mnt/labbackup/lab-suite

# Daily run time, in TZ
BACKUP_HOUR=2
BACKUP_MINUTE=30
TZ=Europe/Amsterdam

# Retention: every run for KEEP_DAILY, then one a week, then one a month
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Optional: POST here when a backup fails (Slack, Teams, ntfy...)
NOTIFY_URL=
# Set to 1 to be told about successes too
NOTIFY_ON_SUCCESS=

# Host directory mounted at /mnt in the backup containers, so the console can
# use a network share mounted anywhere beneath it.
BACKUP_ROOT=/mnt
# Paths the console is allowed to write backups to.
ALLOWED_BACKUP_ROOTS=/mnt:/backup
# Signs the backup console's own sessions; defaults to SECRET_KEY.
BACKUP_CONSOLE_SECRET=
# Signs the suite's sign-in, which every tool trusts; defaults to SECRET_KEY.
SUITE_SECRET_KEY=

# Pinned in docker-compose.yml; set only to try a newer release of one tool.
# MOCLO_VERSION=
# EDITOR_VERSION=
