# Copy to .env and fill in. Never commit the real .env.

# Required. Use two different random values:
#   openssl rand -hex 32
SECRET_KEY=
MOCLO_SECRET_KEY=

# Host port for the whole suite
SUITE_PORT=8080

# Creates the Plasmid Editor's first admin account on an empty database
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set false once the lab has its accounts
ALLOW_REGISTRATION=true

# Pre-filled lab name on parts contributed to the MoClo library
DEFAULT_LAB_SOURCE=Gardiner Lab

# Set true once TLS terminates in front of this stack
SESSION_COOKIE_SECURE=false

# Only for docker-compose.local.yml: where the editor checkout lives
EDITOR_SRC=../plasmid-editor

# --- Backups (see docs/BACKUP.md) -------------------------------------------
# Where the nightly backup is written. Point this at the mounted network drive
# and run 'make backup-init' once; the backup refuses to run until you do, so
# that a drive which failed to mount is never silently used instead.
BACKUP_DEST=/mnt/labbackup/lab-suite

# Daily run time, in TZ
BACKUP_HOUR=2
BACKUP_MINUTE=30
TZ=Europe/Amsterdam

# Retention: every run for KEEP_DAILY, then one a week, then one a month
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Optional: POST here when a backup fails (Slack, Teams, ntfy...)
NOTIFY_URL=
# Set to 1 to be told about successes too
NOTIFY_ON_SUCCESS=
